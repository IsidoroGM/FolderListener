include README.md CHANGELOG.md LICENSE.template requirements-build.txt .gitignore
recursive-include docs *.md
recursive-include licenses *
recursive-include packaging *.spec *.iss
recursive-include scripts *.py *.ps1 *.sh
recursive-include tests *.py
